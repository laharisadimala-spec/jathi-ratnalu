# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — JATHI RATNALU
# ==============================================================================
# This application is currently a static React/Vite frontend.
# Do NOT place secret private keys or credentials in client-side VITE_* variables.
# Vite variables prefixed with VITE_ are embedded into the client bundle.
#
# If serverless functions or private cloud storage (e.g. AWS S3 / Cloudflare R2)
# are integrated for private photo authorization in the future, set them in Vercel
# Project Settings > Environment Variables without the VITE_ prefix.
# ==============================================================================

# Example Public Client Configuration (Safe to expose to browser if needed)
# VITE_APP_ENV=production

# Example Serverless / Private Storage Credentials (SERVER-SIDE ONLY, NEVER EXPOSE)
# PRIVATE_STORAGE_BUCKET=jathi-ratnalu-private-media
# PRIVATE_STORAGE_REGION=us-east-1
# PRIVATE_STORAGE_ACCESS_KEY_ID=
# PRIVATE_STORAGE_SECRET_ACCESS_KEY=
# PRIVATE_AUTH_SECRET=
